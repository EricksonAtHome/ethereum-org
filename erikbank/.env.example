# PostgreSQL (transaction database + WWFT records)
POSTGRES_DB=erikbank
POSTGRES_USER=erikbank
POSTGRES_PASSWORD=erikbank
DATABASE_URL=postgresql://erikbank:erikbank@localhost:5432/erikbank

# Real USDT receive wallets (optional — auto-generated on first boot if empty)
# Set these to YOUR wallets to receive funds directly
UPAY_TRC20_WALLET=
UPAY_ERC20_WALLET=

# Blockchain API keys (required for production ERC20 monitoring)
INFURA_API_KEY=
ETHERSCAN_API_KEY=

# UPay merchant credentials
UPAY_GATEWAY_URL=http://localhost:8090
UPAY_PUBLIC_URL=http://localhost:8090
UPAY_APP_ID=ciofh5fe
UPAY_APP_SECRET=ed696eb5bba1f7460585cc6975e6cf9bf24903dd

# UPay MySQL + Redis
UPAY_MYSQL_DATABASE=upay
UPAY_MYSQL_USER=upay
UPAY_MYSQL_PASSWORD=upay

# Java core-banking
JDBC_URL=jdbc:postgresql://localhost:5432/erikbank
DB_USER=erikbank
DB_PASSWORD=erikbank

# C# enterprise
