[EASYADMIN]
ADMIN=admin
CAPTCHA=false
IS_DEMO=false
CDN=
EXAMPLE=false
STATIC_PATH=/static
OSS_STATIC_PREFIX=static_easyadmin

[REDIS]
host=upay-redis
port=6379
password=
